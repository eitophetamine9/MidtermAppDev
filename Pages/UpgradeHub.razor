@page "/upgrade-hub"
@inject GameSessionState GameState
@inject NavigationManager Navigation

<PageTitle>UPGRADE HUB // CyberType Tech Lab</PageTitle>

<div class="min-h-screen bg-gray-950 text-slate-100 flex flex-col justify-between p-6 md:p-12 relative overflow-hidden font-mono select-none cursor-default">
    <!-- Background ambiance -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f293718_1px,transparent_1px),linear-gradient(to_bottom,#1f293718_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none select-none"></div>
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl pointer-events-none select-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none select-none"></div>

    <!-- Header -->
    <header class="relative z-10 flex flex-col sm:flex-row items-center justify-between border-b border-gray-800 pb-6 gap-4 select-none">
        <div>
            <div class="flex items-center gap-2 select-none">
                <span class="text-xs uppercase tracking-widest text-cyan-400 font-semibold">Wave @(GameState.WaveNumber) Cleared</span>
                <span class="px-2 py-0.5 rounded text-[10px] bg-purple-950 text-purple-300 border border-purple-800 font-bold">ARMORY AVAILABLE</span>
            </div>
            <h1 class="text-3xl font-extrabold text-white tracking-tight mt-1 select-none">SYNTACTIC UPGRADE MATRIX</h1>
        </div>

        <div class="flex items-center gap-6 text-xs select-none">
            <div class="text-right">
                <div class="text-gray-500">CURRENT SCORE</div>
                <div class="text-white font-bold text-base font-mono">@GameState.Score.ToString("N0")</div>
            </div>
            <div class="text-right">
                <div class="text-gray-500">CREDITS ACQUIRED</div>
                <div class="text-cyan-400 font-bold text-base font-mono">@GameState.Currency CR</div>
            </div>
        </div>
    </header>

    <!-- Center Section: 3 Centered Upgrade Cards using Tailwind Flexbox -->
    <main class="relative z-10 py-10 flex-1 flex flex-col items-center justify-center select-none">
        <div class="text-center space-y-2 mb-8 select-none">
            <h2 class="text-xl font-bold text-white tracking-wide">SELECT AN UPGRADE TO ADVANCE TO WAVE @(GameState.WaveNumber + 1)</h2>
            <p class="text-xs text-gray-400 max-w-xl mx-auto">
                Each upgrade permanently modifies your ship's defensive matrix for the remainder of this run. Choose wisely based on incoming threats.
            </p>
        </div>

        <!-- 3 Randomized Cards with Tailwind Centering -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full max-w-5xl select-none">
            @foreach (var upgrade in currentUpgrades)
            {
                <div @onclick="() => SelectUpgrade(upgrade)"
                     class="group relative rounded-2xl bg-gray-900/90 backdrop-blur-xl border border-gray-700 hover:border-cyan-400 p-6 flex flex-col justify-between cursor-pointer transition-all duration-200 hover:-translate-y-2 hover:shadow-[0_0_30px_rgba(34,211,238,0.25)] space-y-6 select-none">
                    
                    <!-- Top badge & icon -->
                    <div class="space-y-4 select-none">
                        <div class="flex items-center justify-between">
                            <span class="text-3xl group-hover:scale-110 transition-transform duration-200">
                                @upgrade.Icon
                            </span>
                            <span class="text-[10px] uppercase font-bold tracking-widest px-2.5 py-1 rounded-full @GetRarityBadge(upgrade.Rarity)">
                                @upgrade.Rarity
                            </span>
                        </div>

                        <div>
                            <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors">
                                @upgrade.Title
                            </h3>
                            <p class="text-xs text-gray-400 leading-relaxed mt-2">
                                @upgrade.Description
                            </p>
                        </div>
                    </div>

                    <!-- Bottom Action Button Indicator -->
                    <div class="pt-4 border-t border-gray-800/80 select-none">
                        <div class="w-full py-3 rounded-xl bg-gray-800 group-hover:btn-cyber-primary text-xs font-black text-gray-200 group-hover:text-black tracking-widest uppercase text-center transition-all duration-150 shadow-sm">
                            Synthesize Upgrade ▶
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Active Upgrades Loadout Strip -->
        @if (GameState.AppliedUpgrades.Count > 0)
        {
            <div class="mt-12 w-full max-w-5xl p-4 rounded-xl bg-gray-900/60 border border-gray-800 backdrop-blur-md select-none">
                <div class="text-[10px] uppercase tracking-wider text-gray-500 mb-2 font-semibold">Active Run Loadout (@GameState.AppliedUpgrades.Count)</div>
                <div class="flex flex-wrap gap-2">
                    @foreach (var applied in GameState.AppliedUpgrades)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-gray-950 border border-gray-800 text-xs text-gray-300 select-none">
                            <span>@applied.Icon</span>
                            <span class="font-medium text-white">@applied.Title</span>
                        </span>
                    }
                </div>
            </div>
        }
    </main>

    <!-- Footer -->
    <footer class="relative z-10 border-t border-gray-800 pt-4 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 select-none">
        <div>CyberType Architecture // State Mutator & Wave Sequencer</div>
        <div class="flex items-center gap-4 mt-2 sm:mt-0">
            <button @onclick="SkipUpgrades" class="cursor-pointer hover:text-gray-300 underline">
                Skip Upgrades & Proceed Direct
            </button>
        </div>
    </footer>
</div>

@code {
    private List<UpgradeOption> currentUpgrades = new();

    protected override void OnInitialized()
    {
        currentUpgrades = GameState.GenerateUpgradeChoices(3);
    }

    private void SelectUpgrade(UpgradeOption upgrade)
    {
        GameState.ApplyUpgrade(upgrade);
        Navigation.NavigateTo("/defense-grid");
    }

    private void SkipUpgrades()
    {
        GameState.WaveNumber++;
        Navigation.NavigateTo("/defense-grid");
    }

    private string GetRarityBadge(string rarity)
    {
        return rarity switch
        {
            "Legendary" => "bg-amber-500/20 text-amber-300 border border-amber-500/40",
            "Epic" => "bg-purple-500/20 text-purple-300 border border-purple-500/40",
            "Rare" => "bg-cyan-500/20 text-cyan-300 border border-cyan-500/40",
            _ => "bg-gray-800 text-gray-400 border border-gray-700"
        };
    }
}
