@page "/defense-grid"
@inject GameSessionState GameState
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>DEFENSE GRID // CyberType OS</PageTitle>

<!-- Fullscreen container with seamless Kenney space_bg.png starry pattern -->
<div class="relative overflow-hidden w-full h-screen font-mono select-none outline-none focus:outline-none cursor-default bg-gray-950"
     style="background-image: url('images/sprites/space_bg.png'); background-repeat: repeat; background-size: 256px 256px;"
     tabindex="0"
     @ref="gridContainer"
     @onkeydown="HandleKeyDown"
     @onclick="FocusGrid">

    <!-- Ambient Dark Grid & Vignette Overlay -->
    <div class="absolute inset-0 bg-gray-950/60 pointer-events-none select-none"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f293710_1px,transparent_1px),linear-gradient(to_bottom,#1f293710_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none select-none"></div>

    <!-- Screen Flash / Damage Glitch Overlay -->
    @if (damageFlash)
    {
        <div class="absolute inset-0 bg-red-600/25 z-40 pointer-events-none select-none animate-pulse"></div>
    }
    @if (typoFlash)
    {
        <div class="absolute inset-0 bg-amber-500/15 z-40 pointer-events-none select-none animate-pulse"></div>
    }

    <!-- TOP HUD: Wave, Difficulty, Lexicon, Timer, Score, Combo, Accuracy -->
    <header class="absolute top-0 left-0 right-0 z-30 px-6 py-4 flex items-center justify-between border-b border-gray-800/80 bg-gray-950/85 backdrop-blur-md select-none">
        <!-- Wave & Badges & Objective -->
        <div class="flex items-center gap-3">
            <div class="px-3.5 py-1.5 rounded-lg bg-cyan-950/70 border border-cyan-500/40 text-cyan-400 font-bold text-sm tracking-wider flex items-center gap-2 shadow-[0_0_12px_rgba(34,211,238,0.2)] select-none">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                WAVE @GameState.WaveNumber
            </div>

            <!-- Difficulty Badge -->
            <span class="px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider border select-none @GetDifficultyBadgeClass()">
                @GameState.SelectedDifficulty
            </span>

            <!-- Lexicon Mode Badge -->
            <span class="px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider border border-purple-500/30 bg-purple-950/60 text-purple-300 select-none">
                @GameState.SelectedLexiconMode
            </span>

            <div class="text-xs text-gray-400 hidden sm:flex items-center gap-1.5 ml-2 select-none">
                <span>TIME:</span>
                <span class="text-white font-bold text-sm font-mono @(waveSecondsRemaining <= 5 ? "text-red-400 animate-pulse" : "text-cyan-300")">
                    @waveSecondsRemaining s
                </span>
            </div>
        </div>

        <!-- Center: Current Locked Word HUD -->
        <div class="hidden md:flex flex-col items-center select-none">
            @if (lockedEnemy != null && !lockedEnemy.IsDestroyed)
            {
                <div class="text-[10px] tracking-widest text-cyan-400 uppercase font-semibold flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                    TARGET LOCKED // [@lockedEnemy.Category]
                </div>
                <div class="text-lg font-bold tracking-wider font-mono">
                    <span class="text-cyan-400 drop-shadow-[0_0_10px_rgba(34,211,238,0.8)]">@lockedEnemy.TypedPart</span><span class="text-amber-300 underline underline-offset-4 animate-pulse">@lockedEnemy.NextChar</span><span class="text-gray-400">@(lockedEnemy.UntypedPart.Length > 0 ? lockedEnemy.UntypedPart.Substring(1) : "")</span>
                </div>
            }
            else
            {
                <div class="text-xs text-gray-500 tracking-wider flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span>
                    RADAR ACTIVE // TYPE FIRST LETTER TO ENGAGE
                </div>
            }
        </div>

        <!-- Right Stats: Shields, Combo, Score, WPM -->
        <div class="flex items-center gap-4 select-none">
            <div class="hidden lg:flex flex-col text-right">
                <span class="text-[10px] text-gray-500">SPEED</span>
                <span class="text-xs font-bold text-cyan-300 font-mono">@GameState.CurrentWpm WPM</span>
            </div>

            <!-- Typo Shields -->
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-gray-900 border border-gray-800 text-xs">
                <span class="text-gray-400">SHIELDS:</span>
                @if (GameState.CurrentTypoShields > 0)
                {
                    <div class="flex gap-1 text-emerald-400">
                        @for (int s = 0; s < GameState.CurrentTypoShields; s++)
                        {
                            <span title="Typo Shield">🛡️</span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-gray-600 font-semibold">0</span>
                }
            </div>

            <!-- Combo Multiplier -->
            @if (GameState.ComboCount > 1)
            {
                <div class="px-2.5 py-1 rounded-lg bg-gradient-to-r from-amber-500/20 to-orange-500/20 border border-amber-500/40 text-amber-300 font-bold text-xs tracking-wide animate-pulse">
                    @(GameState.ComboCount)x COMBO
                </div>
            }

            <!-- Score -->
            <div class="text-right">
                <div class="text-[10px] text-gray-500 tracking-wider">SCORE</div>
                <div class="text-base font-extrabold text-white tracking-wider font-mono">
                    @GameState.Score.ToString("N0")
                </div>
            </div>
        </div>
    </header>

    <!-- LASER ATTACK VISUAL (SVG targeting line & laser_beam.png pulse) -->
    <svg class="absolute inset-0 w-full h-full pointer-events-none select-none z-10">
        @if (lockedEnemy != null && !lockedEnemy.IsDestroyed)
        {
            <line x1="50%" y1="88%"
                  x2="@($"{lockedEnemy.X}%")" y2="@($"{lockedEnemy.Y + 25}px")"
                  stroke="#22d3ee" stroke-width="2.5" stroke-dasharray="8,4"
                  class="opacity-80 animate-pulse" />
            <circle cx="@($"{lockedEnemy.X}%")" cy="@($"{lockedEnemy.Y + 25}px")" r="18"
                    fill="none" stroke="#22d3ee" stroke-width="2" class="opacity-90 animate-ping" />
        }
    </svg>

    <!-- LASER BEAM SPRITE ATTACK BOLT -->
    @if (lockedEnemy != null && !lockedEnemy.IsDestroyed)
    {
        <div class="absolute z-15 pointer-events-none select-none transition-all duration-75 flex items-center justify-center"
             style="left: @(lockedEnemy.X)%; top: @(lockedEnemy.Y + 35)px; transform: translate(-50%, 0);">
            <img src="images/sprites/laser_beam.png" 
                 alt="Laser Beam" 
                 class="w-3 h-10 object-contain drop-shadow-[0_0_15px_rgba(34,211,238,1)] animate-pulse" />
        </div>
    }

    <!-- FLOATING COMBAT TEXTS (+POINTS, TYPO, SHIELD) -->
    @foreach (var fct in floatingTexts)
    {
        <div class="absolute z-30 font-bold font-mono text-sm pointer-events-none select-none transition-all duration-300 @fct.ColorClass"
             style="left: @(fct.X)%; top: @(fct.Y)px; opacity: @fct.Opacity; transform: translate(-50%, -100%);">
            @fct.Text
        </div>
    }

    <!-- ENEMIES RENDERING FIELD (Kenney 2D Sprite Craft + Word Badges) -->
    <div class="absolute inset-0 z-20 pointer-events-none select-none">
        @foreach (var enemy in activeEnemies)
        {
            @if (!enemy.IsDestroyed)
            {
                <div class="absolute transition-all duration-75 flex flex-col items-center select-none"
                     style="left: @(enemy.X)%; top: @(enemy.Y)px; transform: translate(-50%, 0);">
                    
                    <!-- 2D Enemy Sprite (Kenney Space Shooter) -->
                    <div class="relative flex items-center justify-center">
                        <img src="@enemy.SpriteUrl" 
                             alt="Enemy Spacecraft" 
                             class="w-12 h-12 object-contain transition-transform duration-150 @(enemy.IsLocked ? "scale-125 filter drop-shadow-[0_0_20px_rgba(34,211,238,0.9)]" : "filter drop-shadow-[0_0_8px_rgba(244,63,94,0.6)]")" />
                        
                        @if (enemy.IsLocked)
                        {
                            <!-- Targeting Reticle Bracket -->
                            <div class="absolute -inset-2 border-2 border-dashed border-cyan-400 rounded-full animate-spin" style="animation-duration: 4s;"></div>
                        }
                    </div>

                    <!-- Word Bubble Layered Below Sprite with High-Contrast Text -->
                    <div class="mt-1 px-3 py-1 rounded-md backdrop-blur-md transition-all duration-150 flex items-center gap-1 select-none
                                @(enemy.IsLocked 
                                    ? "bg-cyan-950/95 border-2 border-cyan-400 shadow-[0_0_20px_rgba(34,211,238,0.7)] scale-105 z-30" 
                                    : "bg-gray-900/90 border border-gray-700/90 shadow-md")">
                        
                        @if (enemy.IsLocked)
                        {
                            <span class="text-cyan-400 font-black text-xs animate-pulse mr-0.5">▶</span>
                        }

                        <!-- Word Text split into Typed and Untyped Substrings -->
                        <span class="text-sm font-black tracking-wider font-mono select-none">
                            <span class="text-cyan-400 font-black drop-shadow-[0_0_10px_rgba(34,211,238,1)]">@enemy.TypedPart</span>
                            @if (enemy.IsLocked && enemy.NextChar.Length > 0)
                            {
                                <span class="text-amber-300 underline font-black underline-offset-2 animate-pulse bg-cyan-900/60 px-1 rounded">@enemy.NextChar</span>
                                <span class="text-gray-300 font-bold">@(enemy.UntypedPart.Length > 0 ? enemy.UntypedPart.Substring(1) : "")</span>
                            }
                            else
                            {
                                <span class="text-gray-300 font-bold">@enemy.UntypedPart</span>
                            }
                        </span>

                        @if (enemy.IsLocked)
                        {
                            <span class="text-cyan-400 font-black text-xs animate-pulse ml-0.5">◀</span>
                        }
                    </div>

                    <!-- Category tag -->
                    <div class="mt-0.5 text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.2 rounded bg-black/75 text-gray-400 border border-gray-800 select-none">
                        @enemy.Category
                    </div>
                </div>
            }
        }
    </div>

    <!-- PLAYER STARFIGHTER CRAFT AT BASE (Bottom Center) -->
    <div class="absolute bottom-20 left-1/2 -translate-x-1/2 z-25 pointer-events-none flex flex-col items-center select-none transition-all duration-150">
        <div class="relative">
            <!-- Player Ship 2D Sprite (Kenney Space Shooter) -->
            <img src="images/sprites/player_ship.png" 
                 alt="Player Starfighter" 
                 class="w-16 h-16 object-contain filter drop-shadow-[0_0_20px_rgba(34,211,238,0.85)] animate-pulse" />
            
            <!-- Thruster Plasma Glow -->
            <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-4 h-4 bg-cyan-400/80 rounded-full blur-sm animate-ping"></div>
        </div>
    </div>

    <!-- DEFENSE BASE AT BOTTOM -->
    <div class="absolute bottom-0 left-0 right-0 z-30 px-6 py-4 border-t border-gray-800/80 bg-gray-950/90 backdrop-blur-lg flex flex-col md:flex-row items-center justify-between gap-4 select-none">
        <!-- Base Health Gauge with Player Ship Icon -->
        <div class="flex items-center gap-3 w-full md:w-80 select-none">
            <div class="w-10 h-10 rounded-lg bg-gray-900 border border-gray-700 flex items-center justify-center p-1">
                <img src="images/sprites/player_ship.png" alt="Player Ship Icon" class="w-8 h-8 object-contain drop-shadow-[0_0_8px_rgba(34,211,238,0.7)]" />
            </div>
            <div class="flex-1 space-y-1">
                <div class="flex justify-between text-xs font-semibold">
                    <span class="text-gray-400">BASE HULL INTEGRITY</span>
                    <span class="@GetHealthTextColorClass()">
                        @GameState.CurrentHealth / @GameState.MaxHealth
                    </span>
                </div>
                <!-- Health Bar with Verified Glowing Green at 100/100 -->
                <div class="h-2.5 w-full bg-gray-900 rounded-full overflow-hidden border border-gray-800 p-0.5">
                    <div class="h-full transition-all duration-300 rounded-full @GetHealthBarColorClass()"
                         style="width: @((double)GameState.CurrentHealth / GameState.MaxHealth * 100)%"></div>
                </div>
            </div>
        </div>

        <!-- Center: Status Diagnostics -->
        <div class="flex items-center gap-2 text-xs text-gray-400 font-mono select-none">
            <div class="w-3 h-3 rounded-full bg-cyan-500 animate-ping-slow"></div>
            <span>STARFIGHTER CANNONS ONLINE</span>
            <span class="text-gray-600">|</span>
            <span>ACCURACY: <strong class="text-white">@GameState.AccuracyPercentage%</strong></span>
            <span class="text-gray-600">|</span>
            <span>WPM: <strong class="text-cyan-300">@GameState.CurrentWpm</strong></span>
            <span class="text-gray-600">|</span>
            <span>HOSTILES: <strong class="text-cyan-400">@activeEnemies.Count(e => !e.IsDestroyed)</strong></span>
        </div>

        <!-- Quick Actions & Abort Run Button -->
        <div class="flex items-center gap-2 select-none">
            <button @onclick="NavigateToUpgradeHubManual" class="cursor-pointer px-3 py-1.5 rounded-lg bg-gray-800/80 hover:bg-gray-700 text-xs text-gray-300 border border-gray-700 transition-colors">
                Skip to Hub
            </button>
            <button @onclick="AbortRun" class="cursor-pointer px-3.5 py-1.5 rounded-lg bg-red-950/60 hover:bg-red-900 text-xs text-red-200 font-semibold border border-red-700/80 hover:border-red-500 transition-all flex items-center gap-1.5 shadow-sm">
                <span>✕</span>
                Abort Run
            </button>
        </div>
    </div>

    <!-- MODAL OVERLAYS (Refactored child components) -->
    @if (isWaveComplete)
    {
        <WaveCompleteModal WaveNumber="@GameState.WaveNumber"
                           Accuracy="@GameState.AccuracyPercentage"
                           Wpm="@GameState.CurrentWpm"
                           WordsCleared="@GameState.WordsCompletedCount"
                           MaxCombo="@GameState.HighestCombo"
                           OnProceed="ProceedToUpgradeHub" />
    }

    @if (GameState.IsGameOver)
    {
        <GameOverModal OnRestart="RestartRun"
                       OnReturnToBriefing="AbortRun" />
    }
</div>

@code {
    private ElementReference gridContainer;
    private System.Threading.Timer? gameLoopTimer;
    private readonly Random random = new();

    private readonly List<EnemyWord> activeEnemies = new();
    private EnemyWord? lockedEnemy = null;
    private readonly List<FloatingCombatText> floatingTexts = new();

    private int waveSecondsRemaining = 30;
    private int waveSpawnCountdownMs = 0;
    private int elapsedWaveMs = 0;
    private int spawnedThisWaveCount = 0;
    private bool isWaveComplete = false;
    private bool isLoopRunning = false;

    private bool damageFlash = false;
    private bool typoFlash = false;
    private int damageFlashTicks = 0;
    private int typoFlashTicks = 0;

    protected override async Task OnInitializedAsync()
    {
        if (!GameState.IsRunActive)
        {
            GameState.ResetRun();
        }

        StartWave();
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FocusGrid();
        }
    }

    private async Task FocusGrid()
    {
        try { await gridContainer.FocusAsync(); } catch { }
    }

    private void StartWave()
    {
        GameState.PrepareForWave();
        activeEnemies.Clear();
        lockedEnemy = null;
        floatingTexts.Clear();
        
        waveSecondsRemaining = GameState.WaveDurationSeconds;
        waveSpawnCountdownMs = 700;
        elapsedWaveMs = 0;
        spawnedThisWaveCount = 0;
        isWaveComplete = false;
        isLoopRunning = true;

        gameLoopTimer?.Dispose();
        gameLoopTimer = new System.Threading.Timer(GameTick, null, 0, 16);
    }

    private void GameTick(object? state)
    {
        if (!isLoopRunning || isWaveComplete || GameState.IsGameOver) return;

        const double deltaTimeMs = 16.0;
        elapsedWaveMs += (int)deltaTimeMs;
        GameState.RunActiveTimeSeconds += deltaTimeMs / 1000.0;

        if (elapsedWaveMs % 1000 < 16 && waveSecondsRemaining > 0)
        {
            waveSecondsRemaining--;
        }

        if (damageFlash && ++damageFlashTicks > 8) { damageFlash = false; damageFlashTicks = 0; }
        if (typoFlash && ++typoFlashTicks > 6) { typoFlash = false; typoFlashTicks = 0; }

        for (int i = floatingTexts.Count - 1; i >= 0; i--)
        {
            floatingTexts[i].Y -= 0.6;
            floatingTexts[i].Opacity -= 0.02;
            if (floatingTexts[i].Opacity <= 0) floatingTexts.RemoveAt(i);
        }

        waveSpawnCountdownMs -= (int)deltaTimeMs;
        if (waveSpawnCountdownMs <= 0 && spawnedThisWaveCount < GameState.EnemiesPerWaveQuota && waveSecondsRemaining > 3)
        {
            SpawnEnemy();
            waveSpawnCountdownMs = GameState.SpawnIntervalMs;
        }

        const double baseLineY = 620.0;
        for (int i = activeEnemies.Count - 1; i >= 0; i--)
        {
            var enemy = activeEnemies[i];
            if (enemy.IsDestroyed) continue;

            enemy.Y += enemy.Speed * GameState.EnemySpeedModifier;

            if (enemy.Y >= baseLineY)
            {
                enemy.IsDestroyed = true;
                if (lockedEnemy == enemy) lockedEnemy = null;

                GameState.TakeDamage(15);
                damageFlash = true;
                damageFlashTicks = 0;
                AddFloatingText("-15 HULL!", enemy.X, baseLineY - 20, "text-red-400 font-extrabold");

                if (GameState.IsGameOver)
                {
                    isLoopRunning = false;
                    gameLoopTimer?.Dispose();
                    InvokeAsync(StateHasChanged);
                    return;
                }
            }
        }

        activeEnemies.RemoveAll(e => e.IsDestroyed && e != lockedEnemy);

        bool allQuotaSpawned = spawnedThisWaveCount >= GameState.EnemiesPerWaveQuota;
        bool allEnemiesCleared = activeEnemies.Count == 0 || activeEnemies.All(e => e.IsDestroyed);

        if ((allQuotaSpawned && allEnemiesCleared) || (waveSecondsRemaining <= 0 && allEnemiesCleared))
        {
            isWaveComplete = true;
            isLoopRunning = false;
            gameLoopTimer?.Dispose();
        }

        InvokeAsync(StateHasChanged);
    }

    private void SpawnEnemy()
    {
        spawnedThisWaveCount++;
        var dict = GameState.GetActiveDictionary();
        string word = dict[random.Next(dict.Count)];
        double xPos = 12 + (random.NextDouble() * 74);

        double baseSpeed = GameState.SelectedDifficulty switch
        {
            GameDifficulty.Easy => 0.40 + (random.NextDouble() * 0.25),
            GameDifficulty.Hard => 0.95 + (random.NextDouble() * 0.50),
            _ => 0.65 + (random.NextDouble() * 0.35)
        };

        string category = word.Length <= 4 ? "Short" : word.Length <= 8 ? "Medium" : "Complex";

        // Assign Kenney sprite based on category / difficulty
        string sprite = category switch
        {
            "Complex" => "images/sprites/enemy_ship_red.png",
            "Medium" => "images/sprites/enemy_ship_blue.png",
            "Short" => "images/sprites/enemy_ship_green.png",
            _ => "images/sprites/enemy_ship.png"
        };

        activeEnemies.Add(new EnemyWord
        {
            Word = word,
            TypedIndex = 0,
            X = xPos,
            Y = 60,
            Speed = baseSpeed,
            Category = category,
            SpriteUrl = sprite,
            IsLocked = false,
            IsDestroyed = false
        });
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (!isLoopRunning || isWaveComplete || GameState.IsGameOver) return;
        if (string.IsNullOrEmpty(e.Key) || e.Key.Length != 1) return;

        char pressedChar = char.ToLowerInvariant(e.Key[0]);
        if (!char.IsLetter(pressedChar)) return;

        if (lockedEnemy == null || lockedEnemy.IsDestroyed)
        {
            var candidate = activeEnemies
                .Where(enemy => !enemy.IsDestroyed && 
                                enemy.UntypedPart.Length > 0 && 
                                char.ToLowerInvariant(enemy.UntypedPart[0]) == pressedChar)
                .OrderByDescending(enemy => enemy.Y)
                .FirstOrDefault();

            if (candidate != null)
            {
                lockedEnemy = candidate;
                lockedEnemy.IsLocked = true;
                lockedEnemy.TypedIndex++;
                GameState.RegisterKeystroke(true);
                AddFloatingText("TARGET ACQUIRED", lockedEnemy.X, lockedEnemy.Y - 25, "text-cyan-300 text-xs");

                if (lockedEnemy.IsCompleted) OnTargetDestroyed(lockedEnemy);
            }
            else
            {
                HandleTypo(50, 400);
            }
        }
        else
        {
            if (lockedEnemy.TypedIndex < lockedEnemy.Word.Length)
            {
                char expectedChar = char.ToLowerInvariant(lockedEnemy.Word[lockedEnemy.TypedIndex]);

                if (pressedChar == expectedChar)
                {
                    lockedEnemy.TypedIndex++;
                    GameState.RegisterKeystroke(true);

                    if (lockedEnemy.IsCompleted) OnTargetDestroyed(lockedEnemy);
                }
                else
                {
                    HandleTypo(lockedEnemy.X, lockedEnemy.Y);
                }
            }
        }

        StateHasChanged();
    }

    private void OnTargetDestroyed(EnemyWord enemy)
    {
        enemy.IsDestroyed = true;
        int pts = GameState.RegisterWordDestroyed(enemy.Word);
        AddFloatingText($"+{pts} PTS", enemy.X, enemy.Y - 15, "text-emerald-400 font-extrabold");

        if (lockedEnemy == enemy) lockedEnemy = null;
        activeEnemies.Remove(enemy);
    }

    private void HandleTypo(double x, double y)
    {
        bool shieldSaved = !GameState.RegisterKeystroke(false);
        typoFlash = true;
        typoFlashTicks = 0;

        if (shieldSaved)
            AddFloatingText("SHIELD BLOCKED!", x, y - 20, "text-emerald-300 font-bold");
        else
            AddFloatingText("TYPO!", x, y - 20, "text-amber-400 font-bold");
    }

    private void AddFloatingText(string text, double x, double y, string colorClass)
    {
        floatingTexts.Add(new FloatingCombatText
        {
            Text = text,
            X = x,
            Y = Math.Max(70, y),
            ColorClass = colorClass,
            Opacity = 1.0
        });
    }

    private string GetHealthBarColorClass()
    {
        double pct = (double)GameState.CurrentHealth / GameState.MaxHealth;
        if (pct < 0.3) return "bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.8)]";
        if (pct < 0.6) return "bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.8)]";
        return "bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]";
    }

    private string GetHealthTextColorClass()
    {
        double pct = (double)GameState.CurrentHealth / GameState.MaxHealth;
        if (pct < 0.3) return "text-red-400 animate-pulse font-bold";
        if (pct < 0.6) return "text-amber-400 font-bold";
        return "text-emerald-400 font-bold";
    }

    private string GetDifficultyBadgeClass()
    {
        return GameState.SelectedDifficulty switch
        {
            GameDifficulty.Easy => "bg-emerald-950/80 text-emerald-400 border-emerald-500/40",
            GameDifficulty.Hard => "bg-rose-950/80 text-rose-400 border-rose-500/40",
            _ => "bg-amber-950/80 text-amber-400 border-amber-500/40"
        };
    }

    private void ProceedToUpgradeHub()
    {
        gameLoopTimer?.Dispose();
        Navigation.NavigateTo("/upgrade-hub");
    }

    private void NavigateToUpgradeHubManual() => ProceedToUpgradeHub();

    private void RestartRun()
    {
        gameLoopTimer?.Dispose();
        GameState.ResetRun();
        StartWave();
        _ = FocusGrid();
    }

    private void AbortRun()
    {
        isLoopRunning = false;
        gameLoopTimer?.Dispose();
        GameState.RecordRunCompletion();
        GameState.IsRunActive = false;
        Navigation.NavigateTo("/");
    }

    public void Dispose() => gameLoopTimer?.Dispose();
}
