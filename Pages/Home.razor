@page "/"
@inject GameSessionState GameState
@inject NavigationManager Navigation

<PageTitle>BRIEFING ROOM // CyberType Terminal OS</PageTitle>

<div class="min-h-screen bg-gray-950 text-slate-100 flex flex-col justify-between p-6 md:p-12 relative overflow-hidden font-mono select-none cursor-default">
    <!-- Cyber Grid Background -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f293718_1px,transparent_1px),linear-gradient(to_bottom,#1f293718_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none select-none"></div>
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none select-none"></div>
    <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none select-none"></div>

    <!-- Header Terminal Banner -->
    <header class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between border-b border-gray-800/80 pb-6 gap-4 select-none">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 flex items-center justify-center font-bold text-xl shadow-[0_0_20px_rgba(34,211,238,0.25)]">
                ⌨️
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-2xl font-black tracking-tight text-white uppercase select-none">CYBERTYPE // COMMAND CONSOLE</h1>
                    <span class="px-2 py-0.5 rounded text-[10px] bg-cyan-950 text-cyan-400 border border-cyan-800/60 font-semibold animate-pulse select-none">SYSTEM ARMED</span>
                </div>
                <p class="text-xs text-gray-400 tracking-wider select-none">DEFENSE GRID TERMINAL PROTOCOL v3.8.4 // BLAZOR WEBASSEMBLY</p>
            </div>
        </div>

        <!-- Navigation & Profile Access -->
        <div class="flex items-center gap-3 text-xs select-none">
            <button @onclick='() => Navigation.NavigateTo("/profile")'
                    class="cursor-pointer px-3.5 py-2 rounded-xl bg-gray-900 hover:bg-gray-800 text-cyan-300 hover:text-white border border-gray-800 hover:border-cyan-500/40 flex items-center gap-2 transition-all shadow-sm">
                <span>👤</span>
                <span>Operator Dossier / Profile</span>
                @if (GameState.BestWpm > 0)
                {
                    <span class="px-1.5 py-0.2 rounded bg-cyan-950 text-[10px] text-cyan-400 font-bold border border-cyan-800/60">
                        @GameState.BestWpm WPM
                    </span>
                }
            </button>
        </div>
    </header>

    <!-- Main Dashboard Grid -->
    <main class="relative z-10 py-8 grid grid-cols-1 lg:grid-cols-3 gap-8 items-start select-none">
        
        <!-- Mission Intel & Configurations -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Frosted Glass Mission Briefing Card -->
            <div class="rounded-2xl bg-gray-900/80 backdrop-blur-xl border border-gray-700/80 p-8 shadow-2xl relative overflow-hidden space-y-6 select-none">
                <div class="space-y-2 select-none">
                    <span class="text-xs uppercase tracking-widest text-cyan-400 font-semibold flex items-center gap-2 select-none">
                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
                        TACTICAL MISSION OVERVIEW
                    </span>
                    <h2 class="text-3xl font-extrabold text-white tracking-tight select-none">
                        Defend The Mainframe Perimeter
                    </h2>
                    <p class="text-sm text-gray-300 leading-relaxed select-none">
                        Hostile syntax and linguistic entities are descending toward your mainframe core. Lock on with rapid keystrokes, eliminate threats before perimeter breach, and synthesize upgrade matrices between waves.
                    </p>
                </div>

                <!-- 1. LEXICON MODE SELECTOR (Syntax, English, Mixed) -->
                <div class="space-y-2 select-none">
                    <div class="flex items-center justify-between">
                        <span class="text-xs uppercase tracking-wider font-bold text-gray-300 flex items-center gap-2">
                            <span>📚</span> Word Lexicon Mode
                        </span>
                        <span class="text-[11px] text-gray-400">Target Vocabulary Source</span>
                    </div>

                    <div class="grid grid-cols-3 gap-3">
                        <div @onclick="() => SelectLexicon(LexiconMode.Mixed)"
                             class="p-3 rounded-xl cursor-pointer transition-all duration-200 border flex flex-col items-center justify-center text-center space-y-1 select-none
                                    @(GameState.SelectedLexiconMode == LexiconMode.Mixed 
                                        ? "bg-purple-950/60 border-purple-400 shadow-[0_0_15px_rgba(168,85,247,0.3)] text-white" 
                                        : "bg-gray-950/70 border-gray-800 hover:border-gray-700 text-gray-400 hover:text-gray-200")">
                            <span class="text-sm font-bold text-purple-300">⚡ MIXED HYBRID</span>
                            <span class="text-[10px] text-gray-400">Syntax + English Words</span>
                        </div>

                        <div @onclick="() => SelectLexicon(LexiconMode.Syntax)"
                             class="p-3 rounded-xl cursor-pointer transition-all duration-200 border flex flex-col items-center justify-center text-center space-y-1 select-none
                                    @(GameState.SelectedLexiconMode == LexiconMode.Syntax 
                                        ? "bg-cyan-950/60 border-cyan-400 shadow-[0_0_15px_rgba(34,211,238,0.3)] text-white" 
                                        : "bg-gray-950/70 border-gray-800 hover:border-gray-700 text-gray-400 hover:text-gray-200")">
                            <span class="text-sm font-bold text-cyan-300">💻 CODE SYNTAX</span>
                            <span class="text-[10px] text-gray-400">C# Keywords & Syntax</span>
                        </div>

                        <div @onclick="() => SelectLexicon(LexiconMode.English)"
                             class="p-3 rounded-xl cursor-pointer transition-all duration-200 border flex flex-col items-center justify-center text-center space-y-1 select-none
                                    @(GameState.SelectedLexiconMode == LexiconMode.English 
                                        ? "bg-emerald-950/60 border-emerald-400 shadow-[0_0_15px_rgba(16,185,129,0.3)] text-white" 
                                        : "bg-gray-950/70 border-gray-800 hover:border-gray-700 text-gray-400 hover:text-gray-200")">
                            <span class="text-sm font-bold text-emerald-300">📖 REGULAR WORDS</span>
                            <span class="text-[10px] text-gray-400">English Vocabulary</span>
                        </div>
                    </div>
                </div>

                <!-- 2. DIFFICULTY SELECTION (Easy, Medium, Hard) -->
                <div class="space-y-2 select-none">
                    <div class="flex items-center justify-between">
                        <span class="text-xs uppercase tracking-wider font-bold text-gray-300 flex items-center gap-2">
                            <span>⚙️</span> Combat Difficulty
                        </span>
                        <span class="text-[11px] text-gray-400">Word Lengths & Fall Speed</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <!-- Easy Option -->
                        <div @onclick="() => SelectDifficulty(GameDifficulty.Easy)"
                             class="p-4 rounded-xl cursor-pointer transition-all duration-200 border flex flex-col justify-between space-y-2 select-none
                                    @(GameState.SelectedDifficulty == GameDifficulty.Easy 
                                        ? "bg-emerald-950/40 border-emerald-500 shadow-[0_0_15px_rgba(16,185,129,0.3)]" 
                                        : "bg-gray-950/70 border-gray-800 hover:border-gray-700 opacity-70 hover:opacity-100")">
                            <div class="flex justify-between items-center select-none">
                                <span class="font-bold text-sm text-emerald-400">EASY</span>
                                <span class="text-xs">🌱</span>
                            </div>
                            <div class="text-[11px] text-gray-400 space-y-1 select-none">
                                <div>• Words: <strong>3-5 Letters</strong></div>
                                <div>• Speed: <strong>Slow (0.65x)</strong></div>
                                <div>• Starter: <strong>+1 Typo Shield</strong></div>
                            </div>
                        </div>

                        <!-- Medium Option -->
                        <div @onclick="() => SelectDifficulty(GameDifficulty.Medium)"
                             class="p-4 rounded-xl cursor-pointer transition-all duration-200 border flex flex-col justify-between space-y-2 select-none
                                    @(GameState.SelectedDifficulty == GameDifficulty.Medium 
                                        ? "bg-amber-950/40 border-amber-500 shadow-[0_0_15px_rgba(245,158,11,0.3)]" 
                                        : "bg-gray-950/70 border-gray-800 hover:border-gray-700 opacity-70 hover:opacity-100")">
                            <div class="flex justify-between items-center select-none">
                                <span class="font-bold text-sm text-amber-400">MEDIUM</span>
                                <span class="text-xs">⚖️</span>
                            </div>
                            <div class="text-[11px] text-gray-400 space-y-1 select-none">
                                <div>• Words: <strong>5-8 Letters</strong></div>
                                <div>• Speed: <strong>Standard (1.0x)</strong></div>
                                <div>• Multiplier: <strong>1.4x Score</strong></div>
                            </div>
                        </div>

                        <!-- Hard Option -->
                        <div @onclick="() => SelectDifficulty(GameDifficulty.Hard)"
                             class="p-4 rounded-xl cursor-pointer transition-all duration-200 border flex flex-col justify-between space-y-2 select-none
                                    @(GameState.SelectedDifficulty == GameDifficulty.Hard 
                                        ? "bg-rose-950/40 border-rose-500 shadow-[0_0_15px_rgba(244,63,94,0.3)]" 
                                        : "bg-gray-950/70 border-gray-800 hover:border-gray-700 opacity-70 hover:opacity-100")">
                            <div class="flex justify-between items-center select-none">
                                <span class="font-bold text-sm text-rose-400">HARD</span>
                                <span class="text-xs">🔥</span>
                            </div>
                            <div class="text-[11px] text-gray-400 space-y-1 select-none">
                                <div>• Words: <strong>8-14 Letters</strong></div>
                                <div>• Speed: <strong>Fast (1.4x)</strong></div>
                                <div>• Multiplier: <strong>2.0x Score</strong></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Deploy Button Action: High-contrast vibrant cyber styling -->
                <div class="pt-2 flex flex-col sm:flex-row items-center gap-4 select-none">
                    <button @onclick="StartNewRun"
                            class="btn-cyber-primary cursor-pointer w-full sm:w-auto px-10 py-4 rounded-xl text-black font-black text-sm tracking-wider uppercase transition-all duration-200 flex items-center justify-center gap-3 select-none">
                        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z" />
                        </svg>
                        INITIALIZE RUN // START [@GameState.SelectedDifficulty.ToString().ToUpper()] [@GameState.SelectedLexiconMode.ToString().ToUpper()]
                    </button>
                    
                    <span class="text-xs text-gray-500 font-mono select-none">
                        Deploy defense grid with selected parameters
                    </span>
                </div>
            </div>

            <!-- Terminal Diagnostics Log -->
            <div class="rounded-2xl bg-gray-900/60 backdrop-blur-md border border-gray-800 p-6 space-y-3 font-mono text-xs select-none">
                <div class="flex items-center justify-between text-gray-500 border-b border-gray-800 pb-2">
                    <span class="text-cyan-400 font-semibold">> SYSTEM BOOT DIAGNOSTICS</span>
                    <span>MODE: @GameState.SelectedLexiconMode.ToString().ToUpper() // @GameState.SelectedDifficulty.ToString().ToUpper()</span>
                </div>
                <div class="space-y-1 text-gray-400 leading-relaxed select-none">
                    <p class="text-emerald-400">[READY] C# WebAssembly Game Loop compiled at 60 FPS.</p>
                    <p class="text-cyan-300">[READY] Active Lexicon: @GameState.GetActiveDictionary().Count words indexed for this run.</p>
                    <p class="text-purple-300">[READY] Lifetime Telemetry tracking Accuracy, WPM, and Wave records.</p>
                </div>
            </div>
        </div>

        <!-- Terminal System Status & History Sidebar -->
        <div class="space-y-6 select-none">
            <!-- Operator Quick Telemetry Card -->
            <div class="rounded-2xl bg-gray-900/80 backdrop-blur-xl border border-gray-700/80 p-6 shadow-xl space-y-4 select-none">
                <div class="flex justify-between items-center select-none">
                    <h3 class="text-sm font-bold text-white tracking-wider uppercase flex items-center gap-2">
                        <span class="text-cyan-400">❖</span> Operator Records
                    </h3>
                    <a href="profile" class="text-xs text-cyan-400 hover:underline cursor-pointer">View All ▶</a>
                </div>

                <div class="grid grid-cols-2 gap-3 text-xs font-mono select-none">
                    <div class="p-3 rounded-xl bg-gray-950 border border-gray-800 select-none">
                        <span class="text-gray-500 text-[10px] block">BEST ACCURACY</span>
                        <span class="text-emerald-400 font-bold text-base">
                            @(GameState.BestAccuracy > 0 ? $"{GameState.BestAccuracy}%" : "--")
                        </span>
                    </div>

                    <div class="p-3 rounded-xl bg-gray-950 border border-gray-800 select-none">
                        <span class="text-gray-500 text-[10px] block">PEAK SPEED</span>
                        <span class="text-cyan-400 font-bold text-base">
                            @(GameState.BestWpm > 0 ? $"{GameState.BestWpm} WPM" : "--")
                        </span>
                    </div>

                    <div class="p-3 rounded-xl bg-gray-950 border border-gray-800 select-none">
                        <span class="text-gray-500 text-[10px] block">LONGEST RUN</span>
                        <span class="text-purple-400 font-bold text-base">
                            @(GameState.LongestWaveRun > 0 ? $"Wave {GameState.LongestWaveRun}" : "--")
                        </span>
                    </div>

                    <div class="p-3 rounded-xl bg-gray-950 border border-gray-800 select-none">
                        <span class="text-gray-500 text-[10px] block">HIGH SCORE</span>
                        <span class="text-amber-300 font-bold text-base">
                            @(GameState.AllTimeHighScore > 0 ? GameState.AllTimeHighScore.ToString("N0") : "--")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Active Dictionary Preview Card based on difficulty & lexicon -->
            <div class="rounded-2xl bg-gray-900/60 backdrop-blur-md border border-gray-800 p-6 space-y-3 select-none">
                <div class="flex items-center justify-between text-xs font-semibold text-gray-400 select-none">
                    <span class="text-gray-300 uppercase tracking-wider">Active Word Stream</span>
                    <span class="text-cyan-400">[@GameState.SelectedLexiconMode / @GameState.SelectedDifficulty]</span>
                </div>
                <div class="flex flex-wrap gap-2 pt-1 select-none">
                    @foreach (var word in GameState.GetActiveDictionary().Take(15))
                    {
                        <span class="px-2.5 py-1 rounded-md bg-gray-950 text-cyan-400/90 border border-cyan-900/40 text-xs font-mono select-none">
                            @word
                        </span>
                    }
                    <span class="px-2.5 py-1 rounded-md bg-gray-950 text-gray-500 border border-gray-800 text-xs font-mono select-none">
                        +@(GameState.GetActiveDictionary().Count - 15) more
                    </span>
                </div>
            </div>
        </div>

    </main>

    <!-- Footer Status -->
    <footer class="relative z-10 border-t border-gray-800/80 pt-4 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 select-none">
        <div>CyberType Survival Engine // Blazor WebAssembly + Tailwind CSS</div>
        <div class="flex gap-4 mt-2 sm:mt-0 select-none">
            <a href="profile" class="hover:text-cyan-400 transition-colors cursor-pointer">Operator Dossier</a>
            <span>•</span>
            <span class="text-cyan-400">60 FPS Native Loop</span>
            <span>•</span>
            <span class="text-emerald-400">Target Lock Engine</span>
        </div>
    </footer>
</div>

@code {
    private void SelectDifficulty(GameDifficulty diff)
    {
        GameState.SetDifficulty(diff);
    }

    private void SelectLexicon(LexiconMode mode)
    {
        GameState.SetLexiconMode(mode);
    }

    private void StartNewRun()
    {
        GameState.ResetRun();
        Navigation.NavigateTo("/defense-grid");
    }
}
