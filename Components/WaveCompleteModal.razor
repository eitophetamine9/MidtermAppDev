<div class="fixed inset-0 z-50 bg-gray-950/90 backdrop-blur-xl flex flex-col items-center justify-center p-6 space-y-6 select-none animate-fade-in">
    <div class="w-16 h-16 rounded-2xl bg-cyan-500/10 border-2 border-cyan-400 flex items-center justify-center text-cyan-300 text-3xl shadow-[0_0_25px_rgba(34,211,238,0.5)]">
        ✓
    </div>
    <div class="text-center space-y-2 select-none">
        <span class="text-xs uppercase tracking-widest text-cyan-400 font-semibold">Sector Secured</span>
        <h2 class="text-4xl font-extrabold text-white tracking-tight">WAVE @WaveNumber COMPLETED</h2>
    </div>

    <div class="grid grid-cols-4 gap-4 w-full max-w-lg p-4 rounded-xl bg-gray-900/80 border border-gray-800 font-mono text-center select-none">
        <div>
            <div class="text-[10px] text-gray-500">ACCURACY</div>
            <div class="text-lg font-bold text-emerald-400">@Accuracy%</div>
        </div>
        <div>
            <div class="text-[10px] text-gray-500">SPEED</div>
            <div class="text-lg font-bold text-cyan-400">@Wpm WPM</div>
        </div>
        <div>
            <div class="text-[10px] text-gray-500">WORDS</div>
            <div class="text-lg font-bold text-purple-400">@WordsCleared</div>
        </div>
        <div>
            <div class="text-[10px] text-gray-500">MAX COMBO</div>
            <div class="text-lg font-bold text-amber-400">@MaxCombo x</div>
        </div>
    </div>

    <!-- Proceed to Upgrade Hub Button with High Contrast & Cyan Glow -->
    <button @onclick="OnProceed"
            class="btn-cyber-primary cursor-pointer px-10 py-4 rounded-xl text-black font-black text-sm tracking-widest uppercase transition-all duration-200 flex items-center justify-center gap-2 select-none">
        <span>PROCEED TO UPGRADE HUB</span>
        <span class="text-base font-bold">▶</span>
    </button>
</div>

@code {
    [Parameter] public int WaveNumber { get; set; }
    [Parameter] public double Accuracy { get; set; }
    [Parameter] public int Wpm { get; set; }
    [Parameter] public int WordsCleared { get; set; }
    [Parameter] public int MaxCombo { get; set; }
    [Parameter] public EventCallback OnProceed { get; set; }
}
